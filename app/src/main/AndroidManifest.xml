<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VacationPlanner">

        <!-- VacationActivity is the launcher -->
        <activity
            android:name=".VacationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Vacation Detail View -->
        <activity
            android:name=".VacationDetailActivity"
            android:exported="false" />

        <!-- Keep MainActivity for later -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- AlarmManager trigger -->
        <receiver
            android:name=".VacationAlertReceiver"
            android:exported="false" />

        <!-- Excursion list -->
        <activity
            android:name=".ExcursionListActivity"
            android:exported="false" />

        <!-- Excursion add/update/delete -->
        <activity
            android:name=".ExcursionActivity"
            android:exported="false" />

        <!-- Excursion Alert Receiver -->
        <receiver
            android:name=".ExcursionAlertReceiver"
            android:exported="false" />

    </application>
</manifest>
